# Build configuration — committed, no secrets here.
#
# Silences the "Failed to parse source map ... vision_bundle_mjs.js.map" warning.
# Cause: the transitive dep @mediapipe/tasks-vision (pulled in by
# @react-three/drei) ends its bundle with a sourceMappingURL pointing at
# vision_bundle_mjs.js.map, a file it never actually publishes. CRA's
# source-map-loader then fails to read it and warns on every compile.
#
# GENERATE_SOURCEMAP=false drops CRA's source-map-loader pre-rule entirely, so
# it stops trying to parse dependency source maps. Your own dev source maps are
# unaffected (dev devtool is independent of this flag), and production builds
# simply ship without public source maps — desirable for a deployed portfolio.
#
# EmailJS secrets do NOT belong here — keep those in .env.local (see .env.example).
GENERATE_SOURCEMAP=false
